# Copy this file to `.env` and fill in the values. `.env` is ignored by git.
# Every command in ./airdrop.py reads this file. Nothing here is committed or published.

# --- network -------------------------------------------------------------------------------
# JSON-RPC endpoint for the chain you are working on (Sepolia for rehearsals, Ethereum for real).
RPC_URL=https://ethereum-sepolia-rpc.example
# Expected chain id. Commands refuse to run if the RPC reports a different chain.
#   Ethereum mainnet = 1, Sepolia = 11155111
CHAIN_ID=11155111
# Used only by `airdrop.py verify-contract` to publish the source code on Etherscan.
ETHERSCAN_API_KEY=

# --- roles (addresses) ----------------------------------------------------------------------
# The ERC-20 token being distributed. On Sepolia this is the rehearsal token you deploy yourself.
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# The account that holds the tokens and approves the airdrop contract for the exact total.
# On Ethereum this is the supply-reserve multisig (a Safe). On Sepolia it can be a plain wallet.
RESERVE_ADDRESS=0x0000000000000000000000000000000000000000
# The account allowed to pause the contract and replace the executor. Normally the same multisig.
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
# The operational wallet that sends the batch transactions. It can only send the committed
# batches, so it does not need to be a multisig, but keep its key on a dedicated machine.
EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000

# --- executor signing ---------------------------------------------------------------------
# Option A: raw private key of EXECUTOR_ADDRESS (0x-prefixed hex).
EXECUTOR_PRIVATE_KEY=
# Option B: leave EXECUTOR_PRIVATE_KEY empty and pass Foundry wallet flags instead, for example
#   FORGE_WALLET_ARGS="--account airdrop-executor"          (encrypted keystore: `cast wallet import`)
#   FORGE_WALLET_ARGS="--ledger --sender 0xYourExecutor"    (hardware wallet)
FORGE_WALLET_ARGS=

# --- current distribution -----------------------------------------------------------------
# Directory produced by `airdrop.py build`, e.g. runs/sepolia-rehearsal or runs/mainnet-priority.
RUN_DIR=runs/example
# Address of the deployed CommittedBatchAirdrop for RUN_DIR. Filled in after `airdrop.py deploy`.
AIRDROP_ADDRESS=
